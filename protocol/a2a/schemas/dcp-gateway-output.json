{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dossy.dev/a2a/dcp-gateway/1/output.json",
  "title": "Dossy A2A gateway direct response",
  "type": "object",
  "additionalProperties": false,
  "required": ["message"],
  "properties": {
    "message": {
      "type": "object",
      "required": ["messageId", "role", "parts", "extensions"],
      "properties": {
        "messageId": { "type": "string" },
        "role": { "const": "ROLE_AGENT" },
        "extensions": { "type": "array", "items": { "const": "https://dossy.dev/a2a/dcp-gateway/1" } },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "data"],
            "properties": {
              "kind": { "const": "data" },
              "data": {
                "type": "object",
                "required": ["operation", "result"],
                "properties": { "operation": { "type": "string" }, "result": {} }
              }
            }
          }
        }
      }
    }
  }
}
