{
  "$id": "https://dossy.dev/schemas/offer-submission.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["offer_id", "request_digest", "expires_at", "declared_fields", "connection_permission", "permission_expires_at", "responder_key", "ciphertext"],
  "properties": {
    "offer_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "request_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expires_at": { "type": "string", "format": "date-time" },
    "declared_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": ["interest", "available_from", "skill_tags", "experience_summary", "introduction_scope"]
      }
    },
    "connection_permission": { "enum": ["preauthorized", "confirm_required"] },
    "permission_expires_at": { "type": "string", "format": "date-time" },
    "responder_key": { "$ref": "https://dossy.dev/schemas/jwk-enc.json" },
    "ciphertext": { "type": "string", "minLength": 1, "maxLength": 24000 }
  }
}
