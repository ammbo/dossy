{
  "$id": "https://dossy.dev/schemas/standing-permission.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local standing permission schema. Execution is disabled in protocol 0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["actions", "classes", "marketplaces", "allowed_fields", "limits", "expires_at", "escalation"],
  "properties": {
    "actions": {
      "type": "array",
      "items": { "enum": ["submit_offer"] }
    },
    "classes": {
      "type": "array",
      "items": { "enum": ["introduction", "advice", "hiring", "event"] }
    },
    "marketplaces": { "type": "array", "items": { "type": "string" } },
    "allowed_fields": { "type": "array", "items": { "type": "string" } },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offers_per_24h": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "escalation": {
      "type": "array",
      "items": {
        "enum": ["revocation", "unfamiliar_terms", "sensitive_fields", "new_person", "commitment", "identity_disclosure"]
      }
    }
  }
}
