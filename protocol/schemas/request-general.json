{
  "$id": "https://dossy.dev/schemas/request-general.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "revision", "class", "vocabulary", "board_id", "tags", "criteria", "terms", "expires_at", "max_connections", "offer_schema", "reply_key"],
  "properties": {
    "protocol": { "const": "dcp/0.2" },
    "revision": { "const": 1 },
    "class": { "const": "general" },
    "vocabulary": { "const": "core/0.2" },
    "board_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*){0,3}$" },
    "tags": { "$ref": "https://dossy.dev/schemas/tag-list.json" },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_tags": { "$ref": "https://dossy.dev/schemas/tag-list.json" }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ask"],
      "properties": {
        "ask": { "type": "string", "minLength": 1, "maxLength": 280 }
      }
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "max_connections": { "type": "integer", "minimum": 1, "maximum": 25 },
    "offer_schema": { "$ref": "https://dossy.dev/schemas/offer-schema.json" },
    "requester_display": { "$ref": "https://dossy.dev/schemas/display.json" },
    "reply_key": { "$ref": "https://dossy.dev/schemas/jwk-enc.json" },
    "note": { "type": "string", "maxLength": 512 }
  }
}
