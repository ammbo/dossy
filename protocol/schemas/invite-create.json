{
  "$id": "https://dossy.dev/schemas/invite-create.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A network invite from the member's budget, or a private-board invite from its organizer. Never names a recipient.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind"],
  "properties": {
    "kind": { "enum": ["network", "board"] },
    "board_id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*){0,3}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 }
  }
}
