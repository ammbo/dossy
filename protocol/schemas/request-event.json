{
  "$id": "https://dossy.dev/schemas/request-event.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "revision", "class", "vocabulary", "marketplace_id", "tags", "criteria", "terms", "expires_at", "max_connections", "offer_schema", "reply_key"],
  "properties": {
    "protocol": { "const": "dcp/0.1" },
    "revision": { "const": 1 },
    "class": { "const": "event" },
    "vocabulary": { "const": "core/0.1" },
    "marketplace_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" },
    "tags": { "$ref": "https://dossy.dev/schemas/tag-list.json" },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_tags": { "$ref": "https://dossy.dev/schemas/tag-list.json" },
        "locations": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^loc:[a-z0-9-]+$" }
        }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "starts_at", "ends_at", "format", "purpose", "response_deadline"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": { "type": "string", "format": "date-time" },
        "format": { "enum": ["in_person", "online"] },
        "location": { "type": "string", "pattern": "^loc:[a-z0-9-]+$" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 128 },
        "response_deadline": { "type": "string", "format": "date-time" }
      }
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "max_connections": { "type": "integer", "minimum": 1, "maximum": 100 },
    "offer_schema": { "$ref": "https://dossy.dev/schemas/offer-schema.json" },
    "requester_display": { "$ref": "https://dossy.dev/schemas/display.json" },
    "reply_key": { "$ref": "https://dossy.dev/schemas/jwk-enc.json" },
    "note": { "type": "string", "maxLength": 512 }
  }
}
