{
  "$id": "https://dossy.dev/schemas/reputation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["issuer", "subject", "as_of", "definitions", "lifetime", "windows"],
  "properties": {
    "issuer": { "type": "string" },
    "subject": { "type": "string" },
    "as_of": { "type": "string", "format": "date-time" },
    "definitions": { "type": "object" },
    "lifetime": { "type": "object" },
    "windows": { "type": "object" },
    "open_requests": { "type": "integer", "minimum": 0 },
    "established_connections": { "type": "integer", "minimum": 0 }
  }
}
