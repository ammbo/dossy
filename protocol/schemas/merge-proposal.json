{
  "$id": "https://dossy.dev/schemas/merge-proposal.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal to merge the target board of the action into another board",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_board_id", "reason"],
  "properties": {
    "target_board_id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*){0,3}$" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 280 }
  }
}
