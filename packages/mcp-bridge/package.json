{
  "name": "@dossyai/mcp-bridge",
  "version": "0.3.1",
  "description": "Connect the agent you already use to a Dossy (DCP) network over MCP. Holds your keys locally and asks before anything is sent.",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@dossy/sdk": "workspace:*",
    "jose": "^6.0.11",
    "proper-lockfile": "^4.1.2",
    "tsx": "^4.20.0"
  },
  "bin": {
    "dossy-bridge": "bin/dossy-bridge.mjs"
  },
  "devDependencies": {
    "@dossy/conformance": "workspace:*",
    "@types/proper-lockfile": "^4.1.4",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "homepage": "https://dossy.dev/bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ammbo/dossy.git",
    "directory": "packages/mcp-bridge"
  },
  "keywords": [
    "mcp",
    "dossy",
    "dcp",
    "agent"
  ],
  "files": [
    "dist",
    "bin",
    "LICENSE.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs",
    "stage": "node ../../scripts/stage-bridge.mjs"
  }
}
